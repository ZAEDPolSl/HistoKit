ungroup() %>%
split(.$Metric) %>%
map(~ ggplot(
.x,
aes(
x = as.factor(Overlap),
y = as.factor(Sigma),
fill = MeanValue
)
) +
geom_tile(color = "white") +
geom_tile(
data = .x %>% filter(is_max),
fill = NA,
color = "green",
linewidth = 1.2
) +
geom_tile(
data = .x %>% filter(is_min),
fill = NA,
color = "red",
linewidth = 1.2
) +
scale_y_discrete(
labels = function(x) {
ifelse(is.na(x) | x == "NA", "Constant", x)
}
) +
theme_bw() +
labs(
y="Gaussian sigma",
fill = "Mean value",
title = unique(.x$Metric),
) +
theme(
plot.margin = margin(1, 1, 1, 1),
plot.caption = element_text(hjust = 0.5, size = 9)
))
final_plot <- ggdraw(combined_plot) +
draw_label(
"Overlap",
x = 0.5,
y = 0.01,
hjust = 0.5,
vjust = 0,
size = 11
) +
draw_label(
expression("Mode"),
x = 0.005,
y = 0.5,
angle = 90,
hjust = 0.5,
vjust = 0,
size = 11
)
final_plot
final_plot
